# Copy to .env — the agent loads it automatically at startup.
# Variables already present in the environment take precedence.

# Path to the YAML config file (default: modems.yaml)
# CONFIG_FILE=modems.yaml

# Override vendel_url from the config file
# VENDEL_URL=http://localhost:8090

# Allow plain http to a non-loopback host (API keys travel unencrypted).
# Only enable on trusted networks, e.g. a docker internal bridge.
# VENDEL_ALLOW_INSECURE_HTTP=true
