# ── Core ──────────────────────────────────────────────────────────────
ENVIRONMENT=local
FIRST_SUPERUSER=admin@vendel.cc
FIRST_SUPERUSER_PASSWORD=changethis

# ── Firebase (FCM) ───────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── OAuth Providers ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Payment (QvaPay) ─────────────────────────────────────────────────
QVAPAY_APP_ID=
QVAPAY_APP_SECRET=

# ── Payment (TronDealer) ────────────────────────────────────────────
TRONDEALER_API_KEY=
TRONDEALER_WEBHOOK_SECRET=
TRONDEALER_CLIENT_ID=

# ── Security ─────────────────────────────────────────────────────────
WEBHOOK_ENCRYPTION_KEY=          # Required: AES key for webhook secrets (use a random 32+ char string)

# ── SMTP (defaults to localhost:1025 for mailcatcher in dev) ─────────
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Backup (Litestream) ─────────────────────────────────────────────
LITESTREAM_REPLICA_URL=             # e.g. s3://my-bucket/vendel/data
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# ── URLs ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:8090
FRONTEND_URL=http://localhost:5173    # Use APP_URL value in production (frontend is embedded in binary)

# ── AWS End User Messaging (AEUM) ───────────────────────────────────
# Set AEUM_ENABLED=true to wire the AWS End User Messaging provider.
# When enabled, Vendel boots a virtual device "AWS End User Messaging"
# that users can target by device_id or fall back to when no physical
# device is online. The pool you point at can contain SMS numbers,
# short codes, and RCS Agents; AWS chooses the channel per recipient.
AEUM_ENABLED=false
AEUM_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AEUM_ORIGINATION_IDENTITY_ARN=        # arn:aws:sms-voice:...:pool/...  (recommended)
AEUM_ORIGINATION_POOL_ARN=             # legacy alias; used only when IDENTITY_ARN is empty
AEUM_CONFIGURATION_SET_NAME=
AEUM_SNS_TOPIC_ARN=                    # arn:aws:sns:<region>:<account>:<topic> — REQUIRED. Pins the SNS topic allowed to deliver events. The webhook fails closed (HTTP 500) when this is empty: SNS signatures only prove the message came from AWS, not from our topic.
AEUM_CHANNEL_MODE=auto                 # MVP supports only "auto"
AEUM_DEVICE_NAME=AWS End User Messaging
