# ── Core ──────────────────────────────────────────────────────────────
ENVIRONMENT=local
FIRST_SUPERUSER=admin@vendel.cc
FIRST_SUPERUSER_PASSWORD=changethis

# ── Firebase (FCM) ───────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── OAuth Providers ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Payment (QvaPay) ─────────────────────────────────────────────────
QVAPAY_APP_ID=
QVAPAY_APP_SECRET=

# ── Payment (TronDealer) ────────────────────────────────────────────
TRONDEALER_API_KEY=
TRONDEALER_WEBHOOK_SECRET=
TRONDEALER_CLIENT_ID=

# ── Security ─────────────────────────────────────────────────────────
WEBHOOK_ENCRYPTION_KEY=          # Required: AES key for webhook secrets (use a random 32+ char string)

# ── SMTP (defaults to localhost:1025 for mailcatcher in dev) ─────────
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Backup (Litestream) ─────────────────────────────────────────────
LITESTREAM_REPLICA_URL=             # e.g. s3://my-bucket/vendel/data
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# ── URLs ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:8090
FRONTEND_URL=http://localhost:5173    # Use APP_URL value in production (frontend is embedded in binary)

# ── AWS End User Messaging (AEUM) ───────────────────────────────────
# Optional external SMS/RCS gateway. When AEUM_ENABLED=true Vendel boots a
# virtual device "AWS End User Messaging" users can target via device_id or
# fall back to when no physical device is online. See
# docs/aws-end-user-messaging-setup.md for the full AWS-side setup.
AEUM_ENABLED=false
AEUM_REGION=us-east-1
AEUM_ORIGINATION_IDENTITY_ARN=          # arn:aws:sms-voice:<region>:<account>:pool/<id>  (recommended)
AEUM_ORIGINATION_POOL_ARN=              # legacy alias; used only when IDENTITY_ARN is empty
AEUM_CONFIGURATION_SET_NAME=
AEUM_SNS_TOPIC_ARN=                     # REQUIRED. arn:aws:sns:<region>:<account>:<topic>. Webhook fail-closes (HTTP 500) if empty.
AEUM_CHANNEL_MODE=auto                  # MVP supports only "auto"
AEUM_DEVICE_NAME=AWS End User Messaging

# ── AWS SDK credentials (read by aws-sdk-go-v2 directly) ────────────
# For local testing against the fake_aeum.py script, any non-empty value works.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# AWS_ENDPOINT_URL=http://127.0.0.1:4567   # uncomment to route SDK calls to a local fake (dev only)
